/* PAGE */
.adminprojects {
  padding: 32px 48px;
  background: #0E0F13;
  min-height: 100vh;
  font-family: "Inter", sans-serif;
}

/* HEADER */
.headerRow {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32px;
}

.pageTitle {
  font-size: 32px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px 0;
}

.subtitle {
  font-size: 14px;
  color: #6E768F;
  margin: 0;
}

.headerActions {
  display: flex;
  gap: 12px;
}

.addBtn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  background: #3225BF;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.addBtn:hover {
  background: #2818a0;
}

/* STATS GRID */
.statsGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}

.statCard {
  background: linear-gradient(180deg, #3225bf2a, #161A23);
  border-radius: 16px;
  padding: 32px 24px;
  border: 1px solid #232836;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  cursor: pointer;
}

.statCard:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  background: linear-gradient(180deg, #3225bf46, #1f2431);
}

.statNumber {
  font-size: 56px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px 0;
  line-height: 1;
}

.statLabel {
  font-size: 14px;
  color: #ffffff;
  font-weight: 500;
  opacity: 0.9;
}

.statIcon {
  position: absolute;
  top: 50px;
  right: 40px;
}


/* PROJECTS GRID */
.allProjects {
  margin-top: 32px;
}

.projectsGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.projectCard {
  background: #161A23;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #232836;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.projectCard::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  opacity: 1;
  transition: opacity 0.3s ease;
}

.highPriority::before {
  background: linear-gradient(90deg, #8b5cf6, #a855f7);
}

.mediumPriority::before {
  background: linear-gradient(90deg, #3b82f6, #2563eb);
}

.lowPriority::before {
  background: linear-gradient(90deg, #10b981, #059669);
}

.projectCard:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  border-color: #3a4553;
}

.priorityBadge {
  display: inline-block;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 16px;
}

.highPriority .priorityBadge {
  background: rgba(139, 92, 246, 0.2);
  color: #a855f7;
}

.mediumPriority .priorityBadge {
  background: rgba(59, 130, 246, 0.2);
  color: #3b82f6;
}

.lowPriority .priorityBadge {
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
}

.projectTitle {
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
  margin: 0 0 8px 0;
  line-height: 1.3;
}

.projectDesc {
  font-size: 13px;
  color: #6E768F;
  margin: 0 0 20px 0;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 40px;
}

.progressSection {
  margin-bottom: 20px;
}

.progressHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.progressLabel {
  font-size: 12px;
  color: #6E768F;
  font-weight: 500;
}

.progressPercent {
  font-size: 12px;
  color: #F1F3F8;
  font-weight: 600;
}

.progressBarContainer {
  height: 6px;
  background: #232836;
  border-radius: 3px;
  overflow: hidden;
}

.progressBarFill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.3s ease;
}

.highPriority .progressBarFill {
  background: linear-gradient(90deg, #8b5cf6, #a855f7);
}

.mediumPriority .progressBarFill {
  background: linear-gradient(90deg, #3b82f6, #2563eb);
}

.lowPriority .progressBarFill {
  background: linear-gradient(90deg, #10b981, #059669);
}

.projectFooter {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16px;
  border-top: 1px solid #232836;
}

.avatarGroup {
  display: flex;
  align-items: center;
  position: relative;
  height: 32px;
}

.avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid #161A23;
  position: absolute;
  object-fit: cover;
}

.projectDate {
  font-size: 12px;
  color: #6E768F;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* MODAL STYLES */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.modalWrap {
  background: #161A23;
  border-radius: 16px;
  max-width: 1200px;
  width: 100%;
  max-height: 90vh;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  border: 1px solid #232836;
}

.left {
  padding: 32px;
  overflow-y: auto;
  max-height: 90vh;
}

.right {
  background: #1a1f2e;
  padding: 32px;
  border-left: 1px solid #232836;
  display: flex;
  flex-direction: column;
  gap: 20px;
  overflow-y: auto;
  max-height: 90vh;
}

.formTitle {
  font-size: 24px;
  font-weight: 600;
  color: #ffffff;
  margin: 0 0 24px 0;
}

.label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: #F1F3F8;
  margin-bottom: 8px;
  margin-top: 16px;
}

.input,
.textarea {
  width: 100%;
  padding: 12px;
  background: #232836;
  border: 1px solid #3a4553;
  border-radius: 8px;
  color: #F1F3F8;
  font-size: 14px;
  font-family: inherit;
  transition: all 0.2s ease;
}

.input:focus,
.textarea:focus {
  outline: none;
  border-color: #3225BF;
  background: #2a3441;
}

.textarea {
  min-height: 100px;
  resize: vertical;
}

.row {
  display: flex;
  gap: 16px;
}

.addRow {
  display: flex;
  justify-content: flex-end;
  margin-top: 8px;
}

.selectedWrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 16px;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: #232836;
  border-radius: 8px;
  border: 1px solid #3a4553;
}

.chipAvatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  object-fit: cover;
}

.chipText {
  display: flex;
  flex-direction: column;
}

.chipName {
  font-size: 13px;
  font-weight: 500;
  color: #F1F3F8;
}

.chipRole {
  font-size: 11px;
  color: #6E768F;
}

.chipRemove {
  background: none;
  border: none;
  color: #6E768F;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  transition: color 0.2s ease;
}

.chipRemove:hover {
  color: #ef4444;
}

.formFooter {
  display: flex;
  gap: 12px;
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid #232836;
}

.cancelBtn,
.createBtn {
  flex: 1;
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.cancelBtn {
  background: #232836;
  border: 1px solid #3a4553;
  color: #F1F3F8;
}

.cancelBtn:hover {
  background: #2a3441;
}

.createBtn {
  background: #3225BF;
  border: none;
  color: white;
}

.createBtn:hover {
  background: #2818a0;
}

.searchWrap {
  margin-bottom: 16px;
}

.search {
  width: 100%;
  padding: 10px 12px;
  background: #232836;
  border: 1px solid #3a4553;
  border-radius: 8px;
  color: #F1F3F8;
  font-size: 14px;
}

.employeesList {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.empCard {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: #232836;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}

.empCard:hover {
  background: #2a3441;
  border-color: #3225BF;
}

.empCard.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.empAvatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
}

.empInfo {
  flex: 1;
}

.empName {
  font-size: 14px;
  font-weight: 500;
  color: #F1F3F8;
}

.empRoleSmall {
  font-size: 12px;
  color: #6E768F;
}

.selectedPanel {
  padding-top: 16px;
  border-top: 1px solid #3a4553;
}

.selectedTitle {
  font-size: 13px;
  font-weight: 600;
  color: #F1F3F8;
  margin-bottom: 12px;
}

.selectedScroll {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 150px;
  overflow-y: auto;
}

.selectedRow {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px;
  background: #232836;
  border-radius: 6px;
}

.smallAvatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
}

.selectedName {
  flex: 1;
  font-size: 13px;
  color: #F1F3F8;
}

.smallRemove {
  background: none;
  border: none;
  color: #6E768F;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  transition: color 0.2s ease;
}

.smallRemove:hover {
  color: #ef4444;
}

.loading {
  text-align: center;
  padding: 40px;
  color: #6E768F;
}

/* RESPONSIVE */
@media (max-width: 1400px) {
  .projectsGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .statsGrid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .projectsGrid {
    grid-template-columns: 1fr;
  }
  
  .modalWrap {
    grid-template-columns: 1fr;
  }
  
  .right {
    border-left: none;
    border-top: 1px solid #232836;
  }
}

@media (max-width: 600px) {
  .adminprojects {
    padding: 20px;
  }
  
  .statsGrid {
    grid-template-columns: 1fr;
  }
  
  .headerRow {
    flex-direction: column;
    gap: 16px;
  }
}
