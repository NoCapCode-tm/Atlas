/* PAGE */
.projectPage {
  padding: 32px 48px;
  background: #0E0F13;
  min-height: 100vh;
  font-family: "Inter", sans-serif;
  color: #ffffff;
}

/* BREADCRUMB */
.breadcrumb {
  font-size: 13px;
  color: #6E768F;
  margin-bottom: 24px;
}

/* HEADER SECTION */
.headerSection {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32px;
  gap: 40px;
}

.headerLeft {
  flex: 1;
}

.headerLeft h1 {
  font-size: 36px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 12px 0;
}

.description {
  font-size: 14px;
  color: #6E768F;
  line-height: 1.6;
  margin: 0 0 20px 0;
  max-width: 600px;
}

.metaRow {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.statusBadge {
  padding: 6px 12px;
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.dueDate {
  font-size: 13px;
  color: #6E768F;
}

.avatars {
  display: flex;
  align-items: center;
  margin-left: 8px;
}

.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid #0E0F13;
  background: #232836;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  color: #F1F3F8;
  margin-left: -8px;
  overflow: hidden;
}

.avatar:first-child {
  margin-left: 0;
}

.avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar.more {
  background: #3225BF;
  color: white;
}

.headerRight {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12px;
  min-width: 300px;
}

.moreBtn,
.addTaskBtn {
  padding: 10px 20px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}

.moreBtn {
  background: #232836;
  color: #F1F3F8;
  padding: 10px 16px;
}

.addTaskBtn {
  background: #3225BF;
  color: white;
}

.addTaskBtn:hover {
  background: #2818a0;
}

.progressInfo {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-top: 8px;
}

.progressLabel {
  font-size: 13px;
  color: #6E768F;
}

.progressValue {
  font-size: 13px;
  font-weight: 600;
  color: #F1F3F8;
}

.progressBar {
  width: 100%;
  height: 8px;
  background: #232836;
  border-radius: 4px;
  overflow: hidden;
  margin-top: 8px;
}

.progressFill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  border-radius: 4px;
  transition: width 0.3s ease;
}

/* TABS */
.tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 32px;
  background: #161A23;
  padding: 6px;
  border-radius: 12px;
  width: fit-content;
}

.tab,
.activeTab {
  padding: 10px 20px;
  border: none;
  background: transparent;
  color: #6E768F;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.activeTab {
  background: #3225BF;
  color: white;
}

.tab:hover {
  background: #232836;
  color: #F1F3F8;
}

/* STATS GRID */
.statsGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}

.statCard {
  background: #161A23;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #232836;
  position: relative;
}

.statIcon {
  width: 48px;
  height: 48px;
  background: rgba(99, 102, 241, 0.2);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.statCard h2 {
  font-size: 36px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px 0;
}

.statCard p {
  font-size: 14px;
  color: #6E768F;
  margin: 0 0 8px 0;
}

.statHint {
  font-size: 12px;
  color: #6E768F;
}

/* BOTTOM GRID */
.bottomGrid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 24px;
}

.activityCard,
.statusCard {
  background: #161A23;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #232836;
}

.activityCard h3,
.statusCard h3 {
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  margin: 0 0 20px 0;
}

.activityList {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.activityItem {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px;
  background: #1a1f2e;
  border-radius: 8px;
}

.activityDot {
  width: 8px;
  height: 8px;
  background: #6366f1;
  border-radius: 50%;
  margin-top: 6px;
  flex-shrink: 0;
}

.activityContent {
  flex: 1;
}

.activityContent p {
  font-size: 13px;
  color: #F1F3F8;
  margin: 0 0 4px 0;
}

.activityContent b {
  color: #ffffff;
}

.activityTask {
  font-size: 12px;
  color: #6E768F;
  display: block;
}

.activityTime {
  font-size: 12px;
  color: #6E768F;
  white-space: nowrap;
}

.doughnutWrapper {
  display: flex;
  justify-content: center;
  margin: 20px 0;
}

.legend {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.legendItem {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #F1F3F8;
}

.legendDot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
}

/* TASKS SECTION */
.tasksSection {
  background: #161A23;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #232836;
}

.taskFilters {
  display: flex;
  gap: 8px;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid #232836;
}

.filterTab {
  padding: 8px 16px;
  border: none;
  background: transparent;
  color: #6E768F;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  border-radius: 6px;
  transition: all 0.2s ease;
}

.filterTab.activeFilter {
  background: #3225BF;
  color: white;
}

.filterTab:hover {
  background: #232836;
  color: #F1F3F8;
}

.taskTable {
  width: 100%;
}

.tableHeader {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr 1fr 0.8fr;
  gap: 16px;
  padding: 12px 16px;
  background: #1a1f2e;
  border-radius: 8px;
  margin-bottom: 8px;
  font-size: 12px;
  font-weight: 600;
  color: #6E768F;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.tableBody {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.tableRow {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr 1fr 0.8fr;
  gap: 16px;
  padding: 16px;
  background: #1a1f2e;
  border-radius: 8px;
  align-items: center;
  transition: all 0.2s ease;
}

.tableRow:hover {
  background: #232836;
}

.colTitle {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
  color: #F1F3F8;
}

.checkbox {
  width: 18px;
  height: 18px;
  border-radius: 4px;
  border: 2px solid #3a4553;
  cursor: pointer;
}

.completedText {
  text-decoration: line-through;
  opacity: 0.6;
}

.statusBadgeTable {
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  display: inline-block;
}

.InProgress {
  background: rgba(59, 130, 246, 0.2);
  color: #3b82f6;
}

.Completed {
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
}

.Pending {
  background: rgba(245, 158, 11, 0.2);
  color: #f59e0b;
}

.ToDo {
  background: rgba(148, 163, 184, 0.2);
  color: #94a3b8;
}

.priorityBadge {
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  display: inline-block;
}

.High {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

.Medium {
  background: rgba(245, 158, 11, 0.2);
  color: #f59e0b;
}

.Low {
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
}

.colStatus,
.colPriority,
.colAssignee,
.colDue,
.colProgress {
  font-size: 13px;
  color: #F1F3F8;
}

/* FILES GRID */
.filesGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.fileCard {
  background: #161A23;
  border-radius: 16px;
  padding: 24px;
  border: 1px solid #232836;
  text-decoration: none;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-height: 200px;
}

.fileCard:hover {
  transform: translateY(-4px);
  border-color: #3a4553;
}

.fileIcon {
  width: 64px;
  height: 64px;
  background: #232836;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6366f1;
}

.fileInfo {
  flex: 1;
}

.fileName {
  font-size: 14px;
  font-weight: 500;
  color: #F1F3F8;
  margin: 0 0 4px 0;
  word-break: break-word;
}

.fileMeta {
  font-size: 12px;
  color: #6E768F;
}

.fileUploader {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-top: 12px;
  border-top: 1px solid #232836;
}

.uploaderAvatar {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #3225BF;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 600;
}

.fileUploader span {
  font-size: 11px;
  color: #6E768F;
}

.uploadCard {
  border: 2px dashed #3a4553;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.uploadCard:hover {
  border-color: #3225BF;
  background: rgba(50, 37, 191, 0.05);
}

.uploadIcon {
  font-size: 32px;
  margin-bottom: 12px;
}

.uploadCard p {
  font-size: 14px;
  font-weight: 500;
  color: #F1F3F8;
  margin: 0 0 4px 0;
}

.uploadCard span {
  font-size: 12px;
  color: #6E768F;
}

/* MILESTONES SECTION */
.milestonesSection {
  background: #161A23;
  border-radius: 16px;
  padding: 32px;
  border: 1px solid #232836;
}

.timeline {
  position: relative;
  padding-left: 40px;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 19px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #232836;
}

.milestoneItem {
  position: relative;
  margin-bottom: 32px;
  display: flex;
  gap: 20px;
}

.milestoneItem:last-child {
  margin-bottom: 0;
}

.milestoneIcon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  position: absolute;
  left: -40px;
  z-index: 1;
  border: 3px solid #0E0F13;
}

.milestoneIcon.completed {
  background: #10b981;
  color: white;
}

.milestoneIcon.inProgress {
  background: #6366f1;
  color: white;
}

.milestoneIcon.upcoming {
  background: #232836;
  color: #6E768F;
}

.milestoneIcon.overdue {
  background: #ef4444;
  color: white;
}

.milestoneContent {
  flex: 1;
  background: #1a1f2e;
  padding: 20px;
  border-radius: 12px;
}

.milestoneHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.milestoneContent h4 {
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  margin: 0;
}

.milestoneDate {
  font-size: 12px;
  color: #6E768F;
}

.milestoneContent p {
  font-size: 13px;
  color: #6E768F;
  margin: 0 0 12px 0;
  line-height: 1.5;
}

.milestoneStatus {
  font-size: 12px;
  font-weight: 500;
  display: inline-block;
}

.completedStatus {
  color: #10b981;
}

.inProgressStatus {
  color: #6366f1;
}

.upcomingStatus {
  color: #6E768F;
}

.overdueStatus {
  color: #ef4444;
}

/* PAGE LOADER */
.pageLoader {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #0E0F13;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loaderCard {
  background: #161A23;
  border-radius: 16px;
  padding: 40px;
  text-align: center;
  border: 1px solid #232836;
}

.spinner {
  width: 40px;
  height: 40px;
  border: 3px solid #232836;
  border-top: 3px solid #3225BF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 16px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loaderCard p {
  color: #6E768F;
  font-size: 14px;
  margin: 0;
}

/* RESPONSIVE */
@media (max-width: 1400px) {
  .statsGrid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .filesGrid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 1024px) {
  .headerSection {
    flex-direction: column;
  }
  
  .headerRight {
    width: 100%;
    align-items: stretch;
  }
  
  .bottomGrid {
    grid-template-columns: 1fr;
  }
  
  .tableHeader,
  .tableRow {
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr 0.8fr;
    font-size: 11px;
  }
}

@media (max-width: 768px) {
  .projectPage {
    padding: 20px;
  }
  
  .statsGrid {
    grid-template-columns: 1fr;
  }
  
  .filesGrid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .tabs {
    width: 100%;
    overflow-x: auto;
  }
}

@media (max-width: 600px) {
  .filesGrid {
    grid-template-columns: 1fr;
  }
  
  .tableHeader {
    display: none;
  }
  
  .tableRow {
    grid-template-columns: 1fr;
    gap: 8px;
  }
}
