/* Daily Reports Page - Matching Design
Color Scheme:
Primary text: #ffffff
Secondary text: #F1F3F8
Tertiary text: #6E768F
bg: #0E0F13
bg card: #161A23
Stroke: #232836
button: #3225BF
*/

.page {
  padding: 32px 48px;
  background: #0E0F13;
  min-height: 100vh;
  font-family: "Inter", sans-serif;
}

/* HEADER */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32px;
}

.header h1 {
  font-size: 32px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px 0;
  display: flex;
  align-items: center;
  gap: 12px;
}

.header h1::before {
  content: "";
  width: 40px;
  height: 40px;
  background: #232836;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.header p {
  font-size: 14px;
  color: #6E768F;
  margin: 0;
}

.dateBox {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

.dateBox span {
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
}

.dateBox small {
  font-size: 13px;
  color: #6E768F;
}

/* TOP GRID */
.topGrid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  margin-bottom: 32px;
}

@media (max-width: 768px) {
  
  .topGrid {
    grid-template-columns: 1fr;
  }
}

/* DEADLINE CARD */
.deadlineCard {
  background: linear-gradient(135deg, #1e2a3a 0%, #252f3f 100%);
  border: 1px solid #232836;
  border-radius: 16px;
  padding: 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.deadlineLeft {
  display: flex;
  align-items: center;
  gap: 16px;
  z-index: 2;
}

.iconCircle {
  width: 48px;
  height: 48px;
  background: rgba(99, 102, 241, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6366f1;
}

.deadlineText h4 {
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  margin: 0 0 4px 0;
}

.deadlineText p {
  font-size: 13px;
  color: #6E768F;
  margin: 0;
}

/* TIMER */
.timerWrap {
  position: relative;
  z-index: 2;
}

.clockBg {
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  width: 120px;
  height: 120px;
  color: rgba(255, 255, 255, 0.03);
  z-index: 0;
}

.timer {
  position: relative;
  z-index: 1;
  text-align: right;
}

.timeRow {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 2px;
}

.timeMain {
  font-size: 48px;
  font-weight: 700;
  color: #ffffff;
  font-family: 'Courier New', monospace;
  line-height: 1;
}

.timeSec {
  font-size: 32px;
  font-weight: 600;
  color: #6E768F;
  font-family: 'Courier New', monospace;
}

.timeLabel {
  font-size: 14px;
  color: #6E768F;
  margin-left: 6px;
}

/* INLINE PROGRESS (under timer) */
.inlineProgress {
  width: 200px;
  height: 4px;
  background: #232836;
  border-radius: 10px;
  margin-top: 12px;
  overflow: hidden;
  margin-left: auto;
}

.inlineFill {
  height: 100%;
  background: linear-gradient(90deg, #3225BF 0%, #5b4dd9 100%);
  border-radius: 10px;
  transition: width 1s linear;
}

/* BORDER PROGRESS (card bottom) */
.borderProgress {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: #232836;
  overflow: hidden;
}

.borderFill {
  height: 100%;
  background: linear-gradient(90deg, #3225BF 0%, #5b4dd9 100%);
  transition: width 1s linear;
}
/* SUBMIT CARD */
.submitCard {
  background: #161A23;
  border: 1px solid #232836;
  border-radius: 16px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
}

.submitCard h4 {
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
  margin: 0;
}

.submitCard p {
  font-size: 13px;
  color: #6E768F;
  margin: 0;
}

.submitCard button {
  margin-top: 12px;
  padding: 12px 24px;
  background: #3225BF;
  border: none;
  border-radius: 10px;
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.submitCard button:hover {
  background: #2a1fa0;
  transform: translateY(-1px);
}

/* FLOATING SUBMIT BUTTON (Mobile Only) */
.floatingSubmitBtn {
  display: none;
}

@media (max-width: 768px) {
  .floatingSubmitBtn {
    display: flex;
    position: fixed;
    bottom: 24px;
    right: 24px;
    padding: 10px;
    background: linear-gradient(135deg, #3225BF 0%, #5b4dd9 100%);
    border: none;
    border-radius: 10px;
    color: #ffffff;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(50, 37, 191, 0.4);
    z-index: 50;
    transition: all 0.3s ease;
  }

  .floatingSubmitBtn:hover {
    transform: scale(1.1);
    box-shadow: 0 12px 32px rgba(50, 37, 191, 0.6);
  }

  .floatingSubmitBtn:active {
    transform: scale(0.95);
  }

  @keyframes pulse {
    0%, 100% {
      box-shadow: 0 8px 24px rgba(50, 37, 191, 0.4);
    }
    50% {
      box-shadow: 0 8px 32px rgba(50, 37, 191, 0.7);
    }
  }
}

/* PAST REPORTS */
.pastReports {
  background: #161A23;
  border: 1px solid #232836;
  border-radius: 16px;
  padding: 24px;
}

.pastHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid #232836;
}

.iconhead {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pastHeader h3 {
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
  margin: 0;
}

.pastHeader span {
  font-size: 12px;
  color: #6E768F;
  background: #232836;
  padding: 6px 12px;
  border-radius: 8px;
  font-weight: 600;
}

/* REPORT ITEM */
.reportItem {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 18px;
  background: #0E0F13;
  border: 1px solid #232836;
  border-radius: 12px;
  margin-bottom: 12px;
  transition: all 0.2s ease;
}

.reportItem:hover {
  background: #161A23;
  border-color: #3225BF;
}

.reportItem:last-child {
  margin-bottom: 0;
}

/* STATUS ICONS */
.statusIcon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.statusIcon.draft {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
}

.statusIcon.success {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
}

.statusIcon.missed {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

/* REPORT INFO */
.reportInfo {
  flex: 1;
}

.reportInfo h4 {
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  margin: 0 0 6px 0;
  display: flex;
  align-items: center;
  gap: 10px;
}

.reportInfo p {
  font-size: 13px;
  color: #F1F3F8;
  margin: 0 0 8px 0;
  line-height: 1.5;
}

.reportInfo small {
  font-size: 12px;
  color: #6E768F;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* BADGES */
.draftBadge {
  font-size: 11px;
  padding: 4px 10px;
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
  border-radius: 6px;
  font-weight: 600;
}

.successBadge {
  font-size: 11px;
  padding: 4px 10px;
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border-radius: 6px;
  font-weight: 600;
}

.missedBadge {
  font-size: 11px;
  padding: 4px 10px;
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border-radius: 6px;
  font-weight: 600;
}

/* MODAL OVERLAY */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal {
  width: 100%;
  max-width: 600px;
  background: #161A23;
  border: 1px solid #232836;
  border-radius: 16px;
  padding: 32px;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Custom Scrollbar for Modal */
.modal::-webkit-scrollbar {
  width: 8px;
}

.modal::-webkit-scrollbar-track {
  background: #0E0F13;
  border-radius: 10px;
}

.modal::-webkit-scrollbar-thumb {
  background: #3225BF;
  border-radius: 10px;
}

/* MODAL HEADER */
.header1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
  padding-bottom: 20px;
  border-bottom: 1px solid #232836;
}

.header1 h2 {
  font-size: 22px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 6px 0;
}

.header1 p {
  font-size: 13px;
  color: #6E768F;
  margin: 0;
  font-weight: 500;
}

.close {
  width: 36px;
  height: 36px;
  background: #232836;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #F1F3F8;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.close:hover {
  background: #2a2f3e;
  transform: rotate(90deg);
}

/* SECTION */
.section {
  margin-bottom: 28px;
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.section h3 {
  font-size: 14px;
  font-weight: 600;
  color: #F1F3F8;
  margin: 0;
}

.sectionHeader span {
  font-size: 12px;
  color: #6E768F;
  font-weight: 600;
}

/* TASK BOX */
.taskBox {
  background: rgba(30, 35, 45, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 20px;
  max-height: 320px;
  overflow-y: auto;
}

/* Custom Scrollbar for Task Box */
.taskBox::-webkit-scrollbar {
  width: 6px;
}

.taskBox::-webkit-scrollbar-track {
  background: transparent;
  border-radius: 10px;
}

.taskBox::-webkit-scrollbar-thumb {
  background: rgba(50, 37, 191, 0.5);
  border-radius: 10px;
}

.taskBox::-webkit-scrollbar-thumb:hover {
  background: #3225BF;
}

.task {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0;
  margin-bottom: 16px;
  background: transparent;
  border-radius: 0;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}

.task:last-of-type {
  margin-bottom: 20px;
}

.task:hover {
  background: transparent;
}

.task input[type="checkbox"] {
  width: 20px;
  height: 20px;
  accent-color: #6366f1;
  cursor: pointer;
  flex-shrink: 0;
  border-radius: 4px;
}

.task span {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.9);
  flex: 1;
  line-height: 1.4;
  word-break: break-word;
}

.task .done {
  text-decoration: line-through;
  color: rgba(255, 255, 255, 0.4);
  opacity: 1;
}

/* ADD TASK INPUT */
.addTaskDropdownWrapper {
  position: relative;
  margin-top: 0;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.addTaskInput {
  display: flex;
  gap: 12px;
  align-items: center;
}

.addTaskInput input {
  flex: 1;
  padding: 10px 14px;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: rgba(255, 255, 255, 0.6);
  font-size: 14px;
  outline: none;
  transition: all 0.2s ease;
}

.addTaskInput input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.addTaskInput input:focus {
  border-color: rgba(99, 102, 241, 0.5);
  background: rgba(0, 0, 0, 0.4);
}

.addTaskInput button {
  padding: 10px 24px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  color: rgba(255, 255, 255, 0.8);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.addTaskInput button:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.25);
}

.addTaskDropdown {
  padding: 12px 14px;
  background: transparent;
  border: 1px dashed #3225BF;
  border-radius: 8px;
  color: #3225BF;
  font-size: 13px;
  font-weight: 600;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.addTaskDropdown:hover {
  background: rgba(50, 37, 191, 0.08);
  border-color: #5b4dd9;
}

.dropdownList {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  background: #0E0F13;
  border: 1px solid #232836;
  border-radius: 10px;
  padding: 8px;
  max-height: 240px;
  overflow-y: auto;
  z-index: 100;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
  animation: dropdownSlide 0.2s ease;
}

@keyframes dropdownSlide {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Custom Scrollbar for Dropdown */
.dropdownList::-webkit-scrollbar {
  width: 6px;
}

.dropdownList::-webkit-scrollbar-track {
  background: #161A23;
  border-radius: 10px;
}

.dropdownList::-webkit-scrollbar-thumb {
  background: #3225BF;
  border-radius: 10px;
}

.dropdownItem {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 10px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-bottom: 4px;
}

.dropdownItem:last-child {
  margin-bottom: 0;
}

.dropdownItem:hover {
  background: #161A23;
}

.dropdownItem input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: #3225BF;
  margin-top: 2px;
  flex-shrink: 0;
}

.dropdownItem span {
  font-size: 13px;
  color: #F1F3F8;
  line-height: 1.5;
  flex: 1;
}

/* TEXTAREA */
.section textarea {
  width: 100%;
  min-height: 140px;
  padding: 14px 16px;
  background: #0E0F13;
  border: 1px solid #232836;
  border-radius: 10px;
  color: #F1F3F8;
  font-size: 14px;
  font-family: inherit;
  resize: vertical;
  outline: none;
  transition: all 0.2s ease;
  line-height: 1.6;
}

.section textarea::placeholder {
  color: #6E768F;
  font-size: 13px;
}

.section textarea:focus {
  border-color: #3225BF;
  background: #0a0b0f;
}

.footerNote {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10px;
  font-size: 11px;
  color: #6E768F;
}

.footerNote span:first-child {
  display: flex;
  align-items: center;
  gap: 4px;
}

.footerNote span:last-child {
  font-weight: 500;
}

/* ACTIONS */
.actions {
  display: flex;
  gap: 12px;
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid #232836;
}

.cancel {
  flex: 1;
  padding: 12px 20px;
  background: #232836;
  border: none;
  border-radius: 10px;
  color: #F1F3F8;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.cancel:hover {
  background: #2a2f3e;
}

.submit {
  flex: 1;
  padding: 12px 20px;
  background: #3225BF;
  border: none;
  border-radius: 10px;
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.submit:hover:not(:disabled) {
  background: #2a1fa0;
  transform: translateY(-1px);
}

.submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .page {
    padding: 24px 20px;
    padding-bottom: 100px; /* Space for floating button */
  }

  .header {
    flex-direction: column;
    gap: 16px;
  }

  .dateBox {
    align-items: flex-start;
  }

  .deadlineCard {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .timerWrap {
    width: 100%;
  }

  .timer {
    text-align: left;
  }

  .timeMain {
    font-size: 36px;
  }

  .timeSec {
    font-size: 24px;
  }

  .inlineProgress {
    width: 100%;
  }

  /* Hide submit card on mobile */
  .submitCard {
    display: none;
  }
}
