/* ================================================================
   EmployeeAnnouncementpage — Dark Theme
   Color scheme matches the rest of the project:
   bg:          #0E0F13
   card bg:     #161A23
   stroke:      #232836
   primary:     #3225BF
   text:        #F1F3F8
   muted:       #6E768F
   ================================================================ */

/* ── Page ── */
.page {
  padding: 28px 48px;
  background: #0E0F13;
  min-height: 100vh;
  font-family: "Inter", sans-serif;
  color: #F1F3F8;
}

/* ── Header + filters wrapper ── */
.headerfilters {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 28px;
  gap: 16px;
}

/* ── Header row ── */
.header {
  display: flex;
  width: 100%;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.header h1 {
  font-size: 28px;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
}

/* ── Unread badge ── */
.unreadBadge {
  margin-left: auto;
}

.unreadBadge span {
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(251, 146, 60, 0.12);
  border: 1px solid rgba(251, 146, 60, 0.35);
  color: #fb923c;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}

/* ── Filter pills ── */
.filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.filterBtn {
  padding: 8px 16px;
  border-radius: 10px;
  border: 1px solid #232836;
  background: #161A23;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  color: #6E768F;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.filterBtn:hover {
  background: #1e2433;
  border-color: #3a4553;
  color: #F1F3F8;
}

.active {
  background: #3225BF;
  color: #ffffff;
  border-color: #3225BF;
}

.active:hover {
  background: #2818a0;
  border-color: #2818a0;
  color: #ffffff;
}

/* ── Announcement card ── */
.card {
  background: #161A23;
  border-radius: 16px;
  border: 1px solid #232836;
  padding: 22px 24px;
  display: flex;
  gap: 18px;
  margin-bottom: 14px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  border-color: #2e3448;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

/* ── Icon wrap ── */
.iconWrap {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(50, 37, 191, 0.15);
  color: #8B7EFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid rgba(50, 37, 191, 0.25);
}

.green {
  background: rgba(16, 185, 129, 0.12);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.25);
}

/* ── Content ── */
.content {
  flex: 1;
  min-width: 0;
}

/* ── Top row: title + priority + date ── */
.topRow {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.topRow h3 {
  font-size: 17px;
  font-weight: 600;
  color: #ffffff;
  margin: 0;
}

.date {
  margin-left: auto;
  font-size: 13px;
  color: #6E768F;
  white-space: nowrap;
}

/* ── Priority badge ── */
.important {
  font-size: 11px;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(239, 68, 68, 0.12);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
  white-space: nowrap;
}

.acknowledged {
  font-size: 13px;
  color: #10b981;
  margin-left: 4px;
}

/* ── Meta row: audience tag + "by" ── */
.meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.orgTag {
  background: rgba(50, 37, 191, 0.12);
  color: #8B7EFF;
  padding: 3px 10px;
  font-size: 12px;
  font-weight: 500;
  border-radius: 6px;
  border: 1px solid rgba(50, 37, 191, 0.25);
}

.teamTag {
  background: rgba(16, 185, 129, 0.12);
  color: #10b981;
  padding: 3px 10px;
  font-size: 12px;
  font-weight: 500;
  border-radius: 6px;
  border: 1px solid rgba(16, 185, 129, 0.25);
}

.by {
  font-size: 13px;
  color: #6E768F;
}

/* ── Message body ── */
.message {
  font-size: 14px;
  color: #8b90a8;
  line-height: 1.65;
  margin-bottom: 18px;
}

/* ── Actions ── */
.actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.primaryBtn {
  background: #3225BF;
  color: #fff;
  border: none;
  border-radius: 10px;
  padding: 9px 18px;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
}

.primaryBtn:hover:not(:disabled) {
  background: #2818a0;
  transform: translateY(-1px);
}

.primaryBtn:disabled {
  background: #1a1f2e;
  color: #6E768F;
  border: 1px solid #232836;
  cursor: not-allowed;
  transform: none;
}

.linkBtn {
  background: none;
  border: none;
  color: #6E768F;
  font-size: 13px;
  cursor: pointer;
  padding: 9px 4px;
  transition: color 0.2s ease;
  font-family: inherit;
}

.linkBtn:hover {
  color: #F1F3F8;
}

/* ── Page loader ── */
.pageLoader {
  position: fixed;
  inset: 0;
  background: #0E0F13;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loaderCard {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  padding: 28px 34px;
  background: #161A23;
  border: 1px solid #232836;
  border-radius: 18px;
}

.loaderCard p {
  font-size: 14px;
  font-weight: 500;
  color: #8B7EFF;
  margin: 0;
}

.spinner {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 4px solid #232836;
  border-top-color: #3225BF;
  animation: spin 0.85s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ── Empty state ── */
.empty {
  text-align: center;
  padding: 60px 24px;
  color: #6E768F;
  font-size: 15px;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */

@media (max-width: 1024px) {
  .page { padding: 24px 32px; }
}

@media (max-width: 768px) {
  .page { padding: 16px 14px; }

  .header h1 { font-size: 22px; }

  .header {
    flex-wrap: wrap;
    gap: 10px;
  }

  .unreadBadge { margin-left: 0; }

  /* Filter row — horizontal scroll on mobile */
  .filters {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
    gap: 8px;
    width: 100%;
  }
  .filters::-webkit-scrollbar { display: none; }
  .filterBtn { flex-shrink: 0; }

  /* Card stacks icon above content on very small screens */
  .card { padding: 16px; gap: 14px; }

  .topRow { gap: 8px; }
  .topRow h3 { font-size: 15px; }
  .date { margin-left: 0; width: 100%; order: 3; }

  .message { font-size: 13px; }

  .primaryBtn { width: 100%; justify-content: center; }
}

@media (max-width: 480px) {
  .page { padding: 12px 10px; }
  .header h1 { font-size: 18px; }
  .iconWrap { width: 36px; height: 36px; border-radius: 10px; }
  .card { flex-direction: column; gap: 12px; }
}
