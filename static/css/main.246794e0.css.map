/* Create Task Modal - Dark Theme
Color Scheme:
Primary text: #ffffff
Secondary text: #F1F3F8
Tertiary text: #6E768F
bg: #0E0F13
bg card: #161A23
Stroke: #232836
button: #3225BF
*/

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(4px);
  display: grid;
  place-items: center;
  z-index: 999;
  padding: 20px;
}

.modal {
  width: 100%;
  max-width: 720px;
  border-radius: 16px;
  background: #161A23;
  border: 1px solid #232836;
  padding: 32px;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Custom Scrollbar */
.modal::-webkit-scrollbar {
  width: 8px;
}

.modal::-webkit-scrollbar-track {
  background: #0E0F13;
  border-radius: 10px;
}

.modal::-webkit-scrollbar-thumb {
  background: #3225BF;
  border-radius: 10px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid #232836;
}

.header h2 {
  font-size: 24px;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
}

/* FORM GRID */
.formGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.fullWidth {
  grid-column: span 2;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.labelu {
  font-size: 14px;
  font-weight: 600;
  color: #F1F3F8;
  margin: 0;
}

.formGrid input,
.formGrid select,
.formGrid textarea {
  background: #0E0F13;
  border: 1px solid #232836;
  border-radius: 10px;
  color: #F1F3F8;
  padding: 12px 14px;
  font-size: 14px;
  font-family: inherit;
  outline: none;
  transition: all 0.2s ease;
}

.formGrid input:focus,
.formGrid select:focus,
.formGrid textarea:focus {
  border-color: #3225BF;
}

.formGrid ::placeholder {
  color: #6E768F;
}

.formGrid textarea {
  min-height: 100px;
  resize: vertical;
}

.formGrid select {
  cursor: pointer;
  appearance: none;
  background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%236E768F' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 14px center;
  padding-right: 40px;
}

/* USER CARD */
.userGrid {
  display: flex;
  justify-content: center;
  margin-bottom: 24px;
}

.userCard {
  background: #0E0F13;
  border: 2px solid #232836;
  border-radius: 12px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  min-width: 240px;
}

.userCard:hover {
  border-color: #3225BF;
  background: #161A23;
}

.userCard.active {
  border-color: #3225BF;
  background: rgba(50, 37, 191, 0.1);
  box-shadow: 0 0 0 3px rgba(50, 37, 191, 0.15);
}

.userCard img {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #232836;
}

.namedesig {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
}

.namedesig b {
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
}

.userCard span {
  font-size: 13px;
  color: #6E768F;
}

.selectHint {
  text-align: center;
  font-size: 14px;
  color: #6E768F;
  margin: 20px 0;
}

/* FOOTER */
.footer {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding-top: 24px;
  border-top: 1px solid #232836;
}

.footer button {
  padding: 12px 24px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}

.footer button:first-child {
  background: #232836;
  color: #F1F3F8;
}

.footer button:first-child:hover {
  background: #2a2f3e;
}

.footer button:last-child {
  background: #3225BF;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 8px;
}

.footer button:last-child:hover {
  background: #2a1fa0;
  transform: translateY(-1px);
}

.footer button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .modal {
    padding: 24px;
  }

  .formGrid {
    grid-template-columns: 1fr;
  }

  .fullWidth {
    grid-column: span 1;
  }

  .userCard {
    min-width: 200px;
  }

  .footer {
    flex-direction: column;
  }

  .footer button {
    width: 100%;
  }
}

