/* PAGE */
.page {
  padding: 28px 50px;
  background: #0E0F13;
  min-height: 100vh;
}

/* HEADER */
.topHeader {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 26px;
  flex-wrap: wrap;
  gap: 20px;
}

.leftHeader {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}

.rightHeader {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  justify-content: flex-end;
}

.avatarWrap {
  border: 2px solid #6366f1;
  border-radius: 50%;
  height:55px;
  width:55px;
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
}

.userText{
  display:flex;
  flex-direction: column;
  align-items: flex-start;
  gap:5px;
}

.userText h2 {
  margin: 0;
  font-size: 24px;
  font-weight: 600;
  color: #ffffff;
}

.statususer{
  display:flex;
  align-items: center;
  justify-content: center;
  gap:10px;
  padding:8px 10px;
}

.PUNCH_IN{
  border: 1px solid rgba(52, 179, 137, 0.3);
  background: rgba(52, 179, 137, 0.1);
  box-shadow: 0px 1px 2px -1px rgba(0, 0, 0, 0.3);
  border-radius:999px;
}

.BREAK{
  border: 1px solid rgba(255, 119, 0, 0.3);
  background: rgba(255, 119, 0, 0.1);
  box-shadow: 0px 1px 2px -1px rgba(0, 0, 0, 0.3);
  border-radius:999px;
}

.PUNCH_OUT{
  border: 1px solid rgba(106, 114, 130, 0.3);
  background: rgba(106, 114, 130, 0.1);
  box-shadow: 0px 1px 2px -1px rgba(0, 0, 0, 0.3);
  border-radius:999px;
}

.userMeta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: #94a3b8;
}

.onlineDot {
  width: 8px;
  height: 8px;
  background: #06b847;
  border-radius: 50%;
}

.breakDot {
  width: 8px;
  height: 8px;
  background: rgb(235, 176, 0);
  border-radius: 50%;
}

.endDot{
  width: 8px;
  height: 8px;
  background: rgb(121, 166, 228);
  border-radius: 50%;
}

.sep {
  margin: 0 4px;
}

/* RIGHT HEADER */

.timerBox {
  display: flex;
  position: relative;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 14px;
  background: #1a1f2e;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 4px 14px rgba(0,0,0,0.3);
}

.playIcon {
  background: #22c55e;
  color: white;
  border-radius: 50%;
  font-size: 12px;
  padding: 6px 10px;
}

.timerLabel {
  font-size: 10px;
  color: #94a3b8;
  margin: 0;
}

.timerValue {
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
}

